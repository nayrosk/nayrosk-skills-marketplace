[Unit]
Description=fixture

[Container]
ContainerName=fixture
Image=docker.io/library/alpine:3.20
Pull=missing
UserNS=keep-id:uid=1000,gid=1000
EnvironmentFile=@HOME@/.fixture/.env
Secret=fixture_secret,type=env,target=APP_SECRET
Volume=@HOME@/.fixture/data:/data:Z
Network=podman
HealthCmd=/bin/true
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Memory=256m
PidsLimit=256
PodmanArgs=--cpus=1.0
LogDriver=journald

[Service]
Restart=always
WorkingDirectory=%h/.fixture
RestartSec=10

[Install]
WantedBy=default.target
