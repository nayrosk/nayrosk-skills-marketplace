[Unit]
Description=fixture

[Container]
ContainerName=fixture
Image=docker.io/library/alpine:3.20
Pull=missing
EnvironmentFile=@HOME@/.fixture/.env
Secret=fixture_secret,type=env,target=APP_SECRET
Volume=@HOME@/.fixture/data:/data:Z
Network=podman
HealthCmd=/bin/true
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Memory=256m
PidsLimit=256
PodmanArgs=--cpus=1.0
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
