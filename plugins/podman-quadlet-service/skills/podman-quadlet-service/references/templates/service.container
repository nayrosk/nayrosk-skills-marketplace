# <SERVICE_NAME> - <one-line purpose>
# Generated by the podman-quadlet-service skill.
# Image pinned to <TAG> (sha256:<DIGEST>). Do not edit by hand: regenerate
# instead, then re-run scripts/validate.sh.
#
# R7 - lifecycle profile (references/lifecycle.md). Keep exactly ONE:
# LIFECYCLE: <daemon|on-demand|socket|job>
# (write it as "# LIFECYCLE: daemon" etc. - the linter reads this line)

[Unit]
Description=<SERVICE_NAME>
Wants=network-online.target
After=network-online.target
# on-demand / socket ONLY: stop once no client scope or proxy needs it.
# DELETE for daemon and job.
StopWhenUnneeded=yes

[Container]
ContainerName=<SERVICE_NAME>

# R1 - tag for humans, digest for the machine
Image=<REGISTRY>/<IMAGE>:<TAG>@sha256:<DIGEST>
# R6 - pull only when the image is absent; no automatic updates
Pull=missing

# R2 - map the container user onto the current user's subuid/subgid range
UserNS=keep-id:uid=<CONTAINER_UID>,gid=<CONTAINER_GID>

# R12 - graceful stop. RunInit=true puts catatonit at PID 1: it forwards
# SIGTERM and reaps orphans. If the image CMD/ENTRYPOINT is a shell form
# (`sh -c ...`), ALSO override it in exec form so the app, not a shell,
# receives the signal (values a shell used to expand must be inlined here;
# say where they come from). DELETE the Exec= line when the image already
# runs the app in exec form.
Exec=<APP_BINARY> <ARGS>
RunInit=true
# Seconds between SIGTERM and SIGKILL; measured app shutdown time + margin.
StopTimeout=<STOP_TIMEOUT>

# R3 - non-secret configuration only, never Environment=
EnvironmentFile=<HOME>/.<SERVICE_NAME>/.env

# R4 - secrets exclusively through podman secrets.
# OPTIONAL: one line per secret this service actually needs. DELETE this
# line entirely when the service needs none - a leftover <SECRET_NAME>
# placeholder makes the container fail to start.
Secret=<SECRET_NAME>,type=env,target=<VAR_NAME>

# R8 - persistent state as bind mounts on the local tree, no named volumes.
# Keep only the mounts this service actually uses; delete the rest.
Volume=<HOME>/.<SERVICE_NAME>/data:<CONTAINER_DATA_PATH>:Z
Volume=<HOME>/.<SERVICE_NAME>/config:<CONTAINER_CONFIG_PATH>:ro,Z

# Network placement (references/networking.md). Use ONE of:
#   - Network=<SERVICE_NAME>.network  for the `internal` decision, or for a
#     service that also needs a named network others can reach it on. The
#     matching <SERVICE_NAME>.network unit must be installed alongside this
#     file, or the Quadlet generator refuses to convert this unit.
#   - Network=<REVERSE_PROXY_NETWORK>  for `public-noauth` / `public-auth` /
#     `monitoring`, joining the existing proxy's network.
#   - delete the line entirely to use Podman's default rootless network.
Network=<NETWORK>

# Published ports. Only for the `loopback` decision (and for a reverse
# proxy's own front door). ALWAYS bind an explicit address: a bare
# `PublishPort=<PORT>:<CONTAINER_PORT>` listens on every interface.
# socket profile: this is the INTERNAL backend port; systemd's
# <SERVICE_NAME>-proxy.socket owns the public one.
# DELETE this line for the `internal` decision and for any service reached
# only through a reverse proxy on a shared network.
PublishPort=127.0.0.1:<PORT>:<CONTAINER_PORT>

# R5 - healthcheck. Write $$ for every shell $ (systemd expands a single $
# to an empty string before the container shell sees it). If the probed
# route needs auth, pass the secret the same way ($${TOKEN}).
HealthCmd=<HEALTH_COMMAND>
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
# daemon ONLY: an unhealthy container is killed, Restart=always revives it.
HealthOnFailure=kill
# on-demand / socket ONLY: the unit counts as "started" once healthy, so
# consumers ordered After= it never hit a cold port. The 1s startup probe
# makes that take seconds rather than a full HealthInterval=.
Notify=healthy
HealthStartupCmd=<HEALTH_COMMAND>
HealthStartupInterval=1s
HealthStartupRetries=<STARTUP_RETRIES>
HealthStartupSuccess=1

# R9 - resource limits (Quadlet has no native CPU key: use PodmanArgs).
# Tmpfs= and /dev/shm pages count against Memory=: size it for both.
Memory=<MEM_LIMIT>
PidsLimit=<PIDS_LIMIT>
PodmanArgs=--cpus=<CPU_LIMIT>

# Browsers (Chromium, Firefox) and some databases need a large /dev/shm;
# the 64m default crashes them. DELETE when the app does not need it.
ShmSize=<SHM_SIZE>

# R10 - logging
LogDriver=journald

# R13 - hardening baseline. Relax a key ONLY after testing that the service
# fails with it, and record the evidence on a keyed marker line:
#   # HARDENING-EXCEPTION: <Key> - <what broke without it, how tested, date>
# Prefer Tmpfs= scratch space over dropping ReadOnly=true.
# DropCapability=ALL empties the capability BOUNDING set; an entrypoint with
# file capabilities then dies with `exec container process <path>: Operation
# not permitted`. Check with
#   podman run --rm --entrypoint /bin/sh <IMAGE> -c 'getcap <ENTRYPOINT>'
# and add back only the capability named there, behind its own marker
# (HARDENING-EXCEPTION: AddCapability - ...).
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,size=64m,noexec,nosuid,nodev

[Service]
# R7 - restart policy by profile:
#   daemon               Restart=always      + RestartSec=
#   on-demand / socket   Restart=on-failure  + RestartSec=
#   job                  Type=oneshot, Restart=no (or on-failure + RestartSec=)
Restart=<RESTART_POLICY>
RestartSec=10
# R12 - must be strictly greater than StopTimeout= (rule of thumb: +15s), or
# systemd kills `podman rm` itself mid-stop.
TimeoutStopSec=<TIMEOUT_STOP_SEC>
# R12 - ONLY for an app with no SIGTERM handler that dies from the default
# action (exit 143). Never list 137/SIGKILL. DELETE otherwise.
SuccessExitStatus=143

# R7 - daemon ONLY. DELETE the whole section for on-demand, socket and job.
[Install]
WantedBy=default.target
