# <SERVICE_NAME>-proxy.service - socket lifecycle (references/lifecycle.md).
# Generated by the podman-quadlet-service skill. Never enable this unit:
# only <SERVICE_NAME>-proxy.socket is enabled, and it starts this one.
[Unit]
Description=<SERVICE_NAME> activation proxy
# Requires= + After=: the container is "started" only once healthy
# (Notify=healthy), so the first proxied connection never hits a cold port.
Requires=<SERVICE_NAME>.service
After=<SERVICE_NAME>.service

[Service]
# Exits after the idle period. Nothing needs the container any more, and
# StopWhenUnneeded=yes stops it. Needs systemd 246 or later.
# <SOCKET_PROXYD>: absolute path resolved by preflight (distro-dependent).
ExecStart=<SOCKET_PROXYD> --exit-idle-time=<IDLE_TIMEOUT> 127.0.0.1:<BACKEND_PORT>
PrivateTmp=yes
NoNewPrivileges=yes
