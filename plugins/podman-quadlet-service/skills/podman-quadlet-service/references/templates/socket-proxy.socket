# <SERVICE_NAME>-proxy.socket - socket lifecycle (references/lifecycle.md).
# Generated by the podman-quadlet-service skill.
# systemd owns the public port; the first connection starts
# <SERVICE_NAME>-proxy.service, which pulls in the container.
[Unit]
Description=<SERVICE_NAME> activation socket

[Socket]
# Always an explicit address: a bare port listens on every interface.
ListenStream=127.0.0.1:<PUBLIC_PORT>

[Install]
WantedBy=sockets.target
