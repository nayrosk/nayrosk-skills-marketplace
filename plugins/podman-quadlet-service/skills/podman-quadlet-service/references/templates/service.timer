# <SERVICE_NAME>.timer - job lifecycle (references/lifecycle.md).
# Generated by the podman-quadlet-service skill. Enable this timer, never
# the service it triggers.
[Unit]
Description=Run <SERVICE_NAME> on schedule

[Timer]
OnCalendar=<ON_CALENDAR>
# Run once at next boot if a scheduled run was missed while powered off.
Persistent=true
# Spread load when several timers share a schedule.
RandomizedDelaySec=<RANDOM_DELAY>

[Install]
WantedBy=timers.target
