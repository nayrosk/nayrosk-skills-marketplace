# <SERVICE_NAME> network (default for every service, R14).
# Internal: no egress. A reverse proxy reaches the service by joining it.

[Unit]
Description=<SERVICE_NAME> internal network

[Network]
NetworkName=<SERVICE_NAME>
# R14: no outbound access (internet, LAN and host). Containers on this
# network still reach each other by name, and PublishPort=127.0.0.1:...
# still works. Removing this line requires a "# EGRESS: <reason>" marker
# in every .container that joins the network.
Internal=true
# Stopping this unit's generated service (<SERVICE_NAME>-network.service)
# removes the network via a generated ExecStopPost, mirroring the container
# unit's own generated ExecStop/ExecStopPost (podman rm), which already
# removes the container on stop without a separate manual step. Without
# this, `podman network ls` accumulates a stranded network on every
# uninstall, since a .network unit only creates the network on start - it
# never deletes it on stop by default.
NetworkDeleteOnStop=true
